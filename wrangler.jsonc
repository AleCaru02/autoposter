{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "./cloudflare/entry.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "APP_BASE_URL": "https://autoposter.02alessandrocaruso.workers.dev",
    "LINKEDIN_CLIENT_ID": "77gm5otb0kan9y",
    "META_APP_ID": "900306149763443"
  },
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
