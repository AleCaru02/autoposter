{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
