# APPLICATION ENVIRONMENT
# Explicit only: LOCAL | STAGING | PRODUCTION
APP_ENV=LOCAL
APP_BASE_URL=http://127.0.0.1:5173

# FRONTEND -> PRODUCT API
# Production Vercel deployment: /api
VITE_API_URL=

# BACKEND HARDENING
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SCANNER_PER_MINUTE=6
RATE_LIMIT_AI_PER_MINUTE=30
MAX_JSON_BODY_BYTES=1000000

# SERVER-SIDE INTEGRATION READINESS — SAFE DEFAULTS
OPENAI_LIVE=false
META_LIVE=false
LINKEDIN_LIVE=false
GBP_LIVE=false
TELEGRAM_LIVE=false
REAL_ANALYTICS=false

# NEON — production database/auth/data API for Post Automatici
NEON_DATABASE_URL=
NEON_DATA_API_URL=
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
ASSET_SIGNING_SECRET=

# OPENAI — server-side only
OPENAI_API_KEY=
# Current 2026-08 cost-aware routing: Luna=high-volume economy, Terra=balanced standard, Sol=quality escalation.
AI_MODEL_TEXT_ECONOMY=gpt-5.6-luna
AI_MODEL_TEXT_STANDARD=gpt-5.6-terra
AI_MODEL_TEXT_PREMIUM=gpt-5.6-sol
AI_MODEL_STRUCTURED_OUTPUT=gpt-5.6-terra
# Hard product rule: generated AI images use only OpenAI Images 2.
AI_MODEL_IMAGE_GENERATION=gpt-image-2
# Mandatory pricing snapshot. If absent/invalid/unknown for a requested model or image size+quality, the paid call fails closed.
# Keep `version` equal to the date the catalog was verified against official OpenAI pricing.
# Current text rates verified 2026-08-25 (USD per 1M tokens):
# Luna input .20 / cached .02 / output 1.20
# Terra input 2.00 / cached .20 / output 12.00
# Sol input 4.00 / cached .40 / output 20.00
# GPT-Image-2 current token rates: image input 8 / cached image input 2 / image output 30; text input 5 / cached text input 1.25.
# Image calls additionally require conservative `estimatedUsdBySizeQuality` ceilings sourced from the current OpenAI image calculator.
# Shape:
# {"version":"2026-08-25","models":{"gpt-5.6-luna":{"inputUsdPer1M":0.20,"cachedInputUsdPer1M":0.02,"outputUsdPer1M":1.20},"gpt-5.6-terra":{"inputUsdPer1M":2,"cachedInputUsdPer1M":0.20,"outputUsdPer1M":12},"gpt-5.6-sol":{"inputUsdPer1M":4,"cachedInputUsdPer1M":0.40,"outputUsdPer1M":20},"gpt-image-2":{"imageInputUsdPer1M":8,"imageCachedInputUsdPer1M":2,"imageOutputUsdPer1M":30,"textInputUsdPer1M":5,"textCachedInputUsdPer1M":1.25,"estimatedUsdBySizeQuality":{"1024x1024":{"low":<VERIFIED>,"medium":<VERIFIED>,"high":<VERIFIED>},"1024x1536":{"low":<VERIFIED>,"medium":<VERIFIED>,"high":<VERIFIED>},"1536x1024":{"low":<VERIFIED>,"medium":<VERIFIED>,"high":<VERIFIED>}}}}}
OPENAI_PRICING_JSON=

# AI spending policy is stored in Neon per owner/profile.
# New owners start at monthly budget = 0; paid AI is therefore blocked until the owner explicitly sets a budget.

# META / INSTAGRAM + FACEBOOK
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# LINKEDIN
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=

# GOOGLE BUSINESS PROFILE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=
GOOGLE_GBP_WEBHOOK_SECRET=

# TELEGRAM APPROVALS
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# CREDENTIAL ENVELOPE — server-side AES-256-GCM
ENCRYPTION_KEY_CURRENT=
ENCRYPTION_KEY_VERSION=1
CREDENTIAL_CIPHER_PROVIDER=aes-256-gcm

# LOCAL TEST HARNESS ONLY — never a user-selectable product mode
# Existing Supabase fixtures remain only for deterministic CI/local E2E tests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_E2E_ENABLED=false
LOCAL_API_URL=http://127.0.0.1:8787
LOCAL_PROVIDER_WEBHOOK_SECRET=local-provider-webhook-secret
VITE_E2E_FIXTURES=false
VITE_LOCAL_API_URL=

# COMMERCIAL PHASE — intentionally disabled until personal product is stable
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CALLBACK PATH CONTRACTS
# <APP_OR_API_BASE>/oauth/meta/callback
# <APP_OR_API_BASE>/oauth/linkedin/callback
# <APP_OR_API_BASE>/oauth/google-business-profile/callback
# <APP_OR_API_BASE>/webhooks/meta
# <APP_OR_API_BASE>/webhooks/telegram
