# APPLICATION ENVIRONMENT
# Explicit only: LOCAL | STAGING | PRODUCTION
APP_ENV=LOCAL
APP_BASE_URL=http://127.0.0.1:5173

# FRONTEND -> PRODUCT API
# Production Vercel deployment: /api
VITE_API_URL=

# BACKEND HARDENING
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SCANNER_PER_MINUTE=6
RATE_LIMIT_AI_PER_MINUTE=30
MAX_JSON_BODY_BYTES=1000000

# SERVER-SIDE INTEGRATION READINESS — SAFE DEFAULTS
OPENAI_LIVE=false
META_LIVE=false
LINKEDIN_LIVE=false
GBP_LIVE=false
TELEGRAM_LIVE=false
REAL_ANALYTICS=false

# NEON — production database/auth/data API for Post Automatici
NEON_DATABASE_URL=
NEON_DATA_API_URL=
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
# Random server-only secret used for temporary signed private asset URLs.
ASSET_SIGNING_SECRET=

# OPENAI — server-side only
OPENAI_API_KEY=
# Cost-aware router. Model names are deliberately configuration-driven so they can track current OpenAI availability/pricing.
AI_MODEL_TEXT_ECONOMY=
AI_MODEL_TEXT_STANDARD=
AI_MODEL_TEXT_PREMIUM=
AI_MODEL_STRUCTURED_OUTPUT=
# Hard product rule: generated AI images use only OpenAI Images 2.
AI_MODEL_IMAGE_GENERATION=gpt-image-2
# Mandatory current pricing catalog. If absent/invalid, paid AI calls fail closed before reaching OpenAI.
# 1 USD is tracked internally as 1,000,000 micros.
# Shape example only; insert CURRENT verified prices, never stale placeholders:
# {"version":"YYYY-MM-DD","models":{"MODEL":{"inputUsdPer1M":0,"cachedInputUsdPer1M":0,"outputUsdPer1M":0},"gpt-image-2":{"imageUsdBySize":{"1024x1024":0,"1024x1536":0,"1536x1024":0}}}}
OPENAI_PRICING_JSON=

# AI spending policy is stored in Neon per owner/profile, not in environment variables.
# New owners start with monthly budget = 0, premium models disabled and hard blocking enabled.

# META / INSTAGRAM + FACEBOOK
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# LINKEDIN
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=

# GOOGLE BUSINESS PROFILE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=
GOOGLE_GBP_WEBHOOK_SECRET=

# TELEGRAM APPROVALS
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# CREDENTIAL ENVELOPE — server-side AES-256-GCM
ENCRYPTION_KEY_CURRENT=
ENCRYPTION_KEY_VERSION=1
CREDENTIAL_CIPHER_PROVIDER=aes-256-gcm

# LOCAL TEST HARNESS ONLY — never a user-selectable product mode
# Existing Supabase fixtures remain only for deterministic CI/local E2E tests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_E2E_ENABLED=false
LOCAL_API_URL=http://127.0.0.1:8787
LOCAL_PROVIDER_WEBHOOK_SECRET=local-provider-webhook-secret
VITE_E2E_FIXTURES=false
VITE_LOCAL_API_URL=

# COMMERCIAL PHASE — intentionally disabled until personal product is stable
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CALLBACK PATH CONTRACTS
# <APP_OR_API_BASE>/oauth/meta/callback
# <APP_OR_API_BASE>/oauth/linkedin/callback
# <APP_OR_API_BASE>/oauth/google-business-profile/callback
# <APP_OR_API_BASE>/webhooks/meta
# <APP_OR_API_BASE>/webhooks/telegram
