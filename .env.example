# APPLICATION ENVIRONMENT
# Explicit only: LOCAL | STAGING | PRODUCTION
APP_ENV=LOCAL
APP_BASE_URL=http://127.0.0.1:5173
LOCAL_API_URL=http://127.0.0.1:8787

# BACKEND HARDENING
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SCANNER_PER_MINUTE=6
RATE_LIMIT_AI_PER_MINUTE=30
MAX_JSON_BODY_BYTES=1000000

# SERVER-SIDE PROVIDER FLAGS — SAFE DEFAULTS
# These flags describe whether a real external integration is configured.
# They do not create alternate application modes.
OPENAI_LIVE=false
META_LIVE=false
LINKEDIN_LIVE=false
GBP_LIVE=false
TELEGRAM_LIVE=false
STRIPE_LIVE=false
AUTO_PUBLISH=false
REAL_ANALYTICS=false
IMAGE_GENERATION_LIVE=false

# SUPABASE — intentionally empty until remote staging exists
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OPENAI — server-side only
OPENAI_API_KEY=
AI_MODEL_TEXT_CHEAP=
AI_MODEL_TEXT_STANDARD=
AI_MODEL_TEXT_REASONING=
AI_MODEL_STRUCTURED_OUTPUT=
AI_MODEL_EMBEDDING=
AI_MODEL_VISION=
AI_MODEL_IMAGE_GENERATION=
AI_MODEL_IMAGE_EDIT=
AI_MODEL_WEB_RESEARCH=

# META
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# LINKEDIN
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=

# GOOGLE BUSINESS PROFILE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=
GOOGLE_GBP_WEBHOOK_SECRET=

# TELEGRAM APPROVALS
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# STRIPE — disabled until commercial phase
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# CREDENTIAL ENVELOPE / FUTURE KMS
ENCRYPTION_KEY_CURRENT=
ENCRYPTION_KEY_VERSION=1
CREDENTIAL_CIPHER_PROVIDER=local-envelope

# LOCAL TEST HARNESS ONLY — never a user-selectable product mode
LOCAL_E2E_ENABLED=false
LOCAL_PROVIDER_WEBHOOK_SECRET=local-provider-webhook-secret
VITE_LOCAL_API_URL=

# CALLBACK PATH CONTRACTS
# <APP_OR_API_BASE>/oauth/meta/callback
# <APP_OR_API_BASE>/oauth/linkedin/callback
# <APP_OR_API_BASE>/oauth/google-business-profile/callback
# <APP_OR_API_BASE>/webhooks/meta
# <APP_OR_API_BASE>/webhooks/telegram
# <APP_OR_API_BASE>/webhooks/stripe
