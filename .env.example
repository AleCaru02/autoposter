# Server-only runtime values. Never prefix secrets with VITE_ and never expose them in the client.
# Fail-closed publishing switch. Only the explicit value false permits real social writes.
SAFE_MODE=true
DATABASE_URL=
OPENAI_API_KEY=
# DEPRECATED: not read by any runtime code. Real AI spend caps live in the database
# (account_ai_budget_policies + activity_ai_budget_policies, editable per profile in the app).
# Kept only so older deployments do not fail validation; safe to leave unset.
OPENAI_TEXT_MONTHLY_BUDGET_USD=
OPENAI_IMAGE_MONTHLY_LIMIT=

# Public production origin used for OAuth callbacks and temporary media delivery.
APP_BASE_URL=https://autoposter.02alessandrocaruso.workers.dev

# Random private secret, minimum 24 characters. Used to sign OAuth state and encrypt provider tokens at rest.
SOCIAL_TOKEN_KEY=

# Meta / Facebook + Instagram professional accounts
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# LinkedIn. Keep organization access false until Community Management API access is actually approved.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608
LINKEDIN_ORGANIZATION_ACCESS=false

# Google Business Profile OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel scheduler (canonical runtime). CRON_SECRET authenticates /api/cron and /api/cron-social.
CRON_SECRET=
# Both opt-in and fail-closed: only the exact value true enables the subsystem.
AUTO_SOCIAL_PUBLISH_ENABLED=false
AUTO_SOCIAL_ANALYTICS_ENABLED=false
# Optional: preview deployments allowed to complete Google auth.
AUTH_PREVIEW_ORIGIN=

# Cloudflare Worker fallback (wrangler var). Vercel is the canonical scheduler; true re-enables Worker crons.
WORKER_SCHEDULER_ENABLED=false

# Higgsfield (personal brand Soul ID; optional video provider). Format keyId:keySecret. Paid, prepaid balance.
HF_CREDENTIALS=
HF_VIDEO_ENABLED=false
