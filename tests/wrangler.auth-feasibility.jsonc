{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "./same-origin-auth-feasibility-worker.mjs",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": true,
  // Verification only: uploaded as an unattached preview version, never production traffic.
  "secrets": {
    "required": ["DATABASE_URL", "AUDIT_SMOKE_TOKEN"]
  }
}
