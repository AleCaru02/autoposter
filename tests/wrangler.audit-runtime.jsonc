{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "./audit-viewer-qa-controller.mjs",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": true,
  // Permanent verifier: preview upload only, never production deployment.
  "secrets": {
    "required": ["DATABASE_URL", "AUDIT_SMOKE_TOKEN"]
  }
}
