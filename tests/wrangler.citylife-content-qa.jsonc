{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "autoposter",
  "main": "./citylife-content-qa-controller.mjs",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": true,
