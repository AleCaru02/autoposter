{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-social",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/render/tick",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron-canary",
      "schedule": "*/10 * 17 11 *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/editorial-agents/strategy-plan",
      "destination": "/api/editorial-agents"
    },
    {
      "source": "/api/generate-text/status",
      "destination": "/api/generate-text-status"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/social/:path*",
      "destination": "/api/social?path=:path*"
    },
    {
      "source": "/api/autopilot/:path*",
      "destination": "/api/autopilot?path=:path*"
    },
    {
      "source": "/api/learning/:path*",
      "destination": "/api/learning?path=:path*"
    },
    {
      "source": "/api/render/:path*",
      "destination": "/api/render?path=:path*"
    },
    {
      "source": "/api/avatar/:path*",
      "destination": "/api/avatar?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/render.ts": {
      "maxDuration": 800,
      "includeFiles": "{node_modules/@ff*-installer/linux-x64/**,node_modules/@fontsource/inter/files/inter-latin-[47]00-normal.woff,node_modules/@resvg/resvg-wasm/*.wasm}"
    },
    "api/avatar.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@ffprobe-installer/linux-x64/**"
    },
    "api/cron.ts": {
      "includeFiles": "{node_modules/@resvg/resvg-wasm/*.wasm,node_modules/@fontsource/inter/files/inter-latin-[47]00-normal.woff}"
    },
    "api/cron-canary.ts": {
      "includeFiles": "{node_modules/@resvg/resvg-wasm/*.wasm,node_modules/@fontsource/inter/files/inter-latin-[47]00-normal.woff}"
    },
    "api/generate-image.ts": {
      "includeFiles": "{node_modules/@resvg/resvg-wasm/*.wasm,node_modules/@fontsource/inter/files/inter-latin-[47]00-normal.woff}"
    },
    "api/autopilot.ts": {
      "includeFiles": "{node_modules/@resvg/resvg-wasm/*.wasm,node_modules/@fontsource/inter/files/inter-latin-[47]00-normal.woff}"
    }
  }
}
