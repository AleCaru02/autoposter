{
  "name": "@socialpilot/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck:source": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests"
  },
  "dependencies": {
    "@socialpilot/contracts": "file:../contracts",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
